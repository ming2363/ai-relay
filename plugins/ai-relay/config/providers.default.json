{
  "version": 1,
  "quotaDb": "~/Library/Application Support/AIQuota5h/state.sqlite",
  "minRemaining": 0.15,
  "lowRemaining": 0.3,
  "staleMinutes": 15,
  "claudeConserveBelow": 0.2,
  "idleTimeoutMin": 20,
  "maxRuntimeMin": 240,
  "selfEditMaxLines": 40,
  "workerFullAccess": true,
  "scoreWeights": {
    "fit": 3,
    "reliability": 3,
    "quota": 0.25,
    "speed": 0.5,
    "load": 0.5
  },
  "providers": {
    "claude": {
      "label": "Claude Pro（主控）",
      "self": true,
      "quota": {
        "provider": "claude",
        "pools": [
          "claude-subscription"
        ]
      }
    },
    "codex": {
      "label": "Codex · ChatGPT Plus",
      "via": "codex-plugin",
      "quota": {
        "provider": "codex",
        "pools": [
          "codex"
        ]
      },
      "modelList": {
        "cmd": [
          "debug",
          "models"
        ],
        "format": "codex-json"
      },
      "pools": {
        "codex": [
          "default",
          "gpt-6.1-sol",
          "gpt-6-astra",
          "gpt-6.1-terra",
          "gpt-6-sol",
          "gpt-6-luna",
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-5.6-luna"
        ]
      },
      "sandbox": "workspace",
      "caps": {
        "web": false,
        "exec": true
      }
    },
    "agy": {
      "label": "Antigravity Pro",
      "via": "relay",
      "quota": {
        "provider": "antigravity"
      },
      "cli": {
        "bin": "agy",
        "prompt": [
          "--print",
          "{prompt}"
        ],
        "model": [
          "--model",
          "{model}"
        ],
        "read": [],
        "write": [
          "--mode",
          "accept-edits"
        ],
        "cwd": null,
        "fullAccess": [
          "--dangerously-skip-permissions"
        ]
      },
      "modelList": {
        "cmd": [
          "models"
        ],
        "format": "agy-table"
      },
      "poolRules": [
        [
          "argon",
          "gemini-argon"
        ],
        [
          "flash",
          "gemini"
        ],
        [
          "^(claude|gpt)",
          "claude-gpt"
        ]
      ],
      "poolLabels": {
        "gemini-argon": "Gemini Argon",
        "claude-gpt": "Claude / GPT",
        "gemini": "Gemini Flash"
      },
      "defaultModels": {
        "gemini-argon": "gemini-4-argon-high",
        "claude-gpt": "claude-opus-5-5-high",
        "gemini": "gemini-3.8-flash-high"
      },
      "pools": {
        "gemini-argon": [
          "gemini-4-argon-high",
          "gemini-4-argon-medium",
          "gemini-4-argon-low"
        ],
        "claude-gpt": [
          "claude-opus-5-5-high",
          "claude-opus-5-5-medium",
          "claude-opus-5-5-low",
          "claude-sonnet-5-5-high",
          "claude-sonnet-5-5-medium",
          "claude-sonnet-5-5-low",
          "gpt-oss-120b-medium"
        ],
        "gemini": [
          "gemini-3.8-flash-high",
          "gemini-3.8-flash-medium",
          "gemini-3.8-flash-low"
        ]
      },
      "caps": {
        "web": true,
        "exec": false
      }
    },
    "grok": {
      "label": "SuperGrok",
      "via": "relay",
      "quota": {
        "provider": "grok"
      },
      "cli": {
        "bin": "grok",
        "prompt": [
          "-p",
          "{prompt}"
        ],
        "model": [
          "--model",
          "{model}"
        ],
        "read": [
          "--permission-mode",
          "plan"
        ],
        "write": [],
        "cwd": [
          "--cwd",
          "{cwd}"
        ],
        "fullAccess": [
          "--always-approve"
        ]
      },
      "modelList": {
        "cmd": [
          "models"
        ],
        "format": "grok-list"
      },
      "pools": {
        "supergrok-weekly": [
          "default"
        ]
      },
      "caps": {
        "web": true,
        "exec": false
      }
    }
  },
  "routes": {
    "implement": [
      "codex:codex:gpt-6.1-sol",
      "codex:codex:gpt-6.1-terra:0.95",
      "agy:gemini-argon:default:0.9",
      "grok:supergrok-weekly:default:0.85",
      "agy:claude-gpt:claude-sonnet-5-5-high:0.55",
      "codex:codex:gpt-6-luna:0.5",
      "agy:gemini:default:0.4"
    ],
    "debug": [
      "codex:codex:gpt-6.1-sol",
      "codex:codex:gpt-6-astra:0.95",
      "grok:supergrok-weekly:default:0.85",
      "codex:codex:gpt-6.1-terra:0.8",
      "agy:gemini-argon:default:0.7",
      "agy:claude-gpt:default:0.55",
      "codex:codex:gpt-6-luna:0.45",
      "agy:gemini:default:0.4"
    ],
    "review": [
      "grok:supergrok-weekly:default",
      "agy:gemini-argon:default:0.85",
      "agy:gemini:default:0.7",
      "codex:codex:gpt-6.1-sol:0.55"
    ],
    "read": [
      "agy:gemini:default",
      "agy:gemini-argon:gemini-4-argon-medium",
      "grok:supergrok-weekly:default"
    ],
    "deep": [
      "agy:gemini-argon:default",
      "codex:codex:gpt-6-astra:0.9",
      "agy:claude-gpt:default:0.85",
      "codex:codex:gpt-6.1-sol:0.7"
    ],
    "quick": [
      "agy:gemini:gemini-3.8-flash-medium",
      "grok:supergrok-weekly:default"
    ],
    "claude-backup": [
      "agy:claude-gpt:default",
      "agy:gemini-argon:default:0.85",
      "codex:codex:gpt-6.1-sol:0.7"
    ]
  }
}
