{
  "kimi": {
    "title": "Kimi Code CLI",
    "label": "Kimi 会员",
    "bin": "kimi",
    "install": "curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash，装好后运行 kimi 并输入 /login 登录",
    "cli": {
      "prompt": [
        "--quiet",
        "-p",
        "{prompt}"
      ],
      "model": [
        "-m",
        "{model}"
      ],
      "read": [
        "--plan"
      ],
      "write": [],
      "cwd": [
        "-w",
        "{cwd}"
      ]
    },
    "models": [
      "default"
    ],
    "roles": [
      "read",
      "review"
    ],
    "note": "Kimi 的无交互模式会自动批准所有工具调用（包括终端命令），只读靠计划模式；relay 会用 git 快照检查是否误改文件"
  },
  "qwen": {
    "title": "Qwen Code",
    "label": "通义千问会员",
    "bin": "qwen",
    "install": "npm install -g @qwen-code/qwen-code@latest，装好后运行 qwen 登录",
    "cli": {
      "prompt": [
        "-p",
        "{prompt}"
      ],
      "model": [
        "-m",
        "{model}"
      ],
      "read": [
        "--approval-mode",
        "plan"
      ],
      "write": [
        "--approval-mode",
        "auto-edit"
      ],
      "cwd": null
    },
    "models": [
      "default"
    ],
    "roles": [
      "read",
      "review"
    ],
    "note": "只读用 plan 模式，可写用 auto-edit（只自动批准改文件，不批准终端命令）"
  },
  "custom": {
    "title": "自定义",
    "label": "",
    "bin": "",
    "install": "",
    "cli": {
      "prompt": [
        "-p",
        "{prompt}"
      ],
      "model": [
        "--model",
        "{model}"
      ],
      "read": [],
      "write": [],
      "cwd": null
    },
    "models": [
      "default"
    ],
    "roles": [
      "read"
    ],
    "note": "任何能用一条命令无交互执行任务、把结果输出到终端的官方 CLI 都可以接入"
  },
  "endpoint": {
    "title": "自定义接口",
    "label": "自定义接口",
    "kind": "endpoint",
    "install": "需要已安装 Claude Code（claude 命令）。密钥不要写在命令里，添加后运行 relay provider key <名称>",
    "billing": "metered",
    "cli": {
      "bin": "claude",
      "prompt": [
        "--bare",
        "-p",
        "{prompt}",
        "--output-format",
        "json"
      ],
      "model": [
        "--model",
        "{model}"
      ],
      "read": [
        "--permission-mode",
        "plan"
      ],
      "write": [
        "--permission-mode",
        "acceptEdits"
      ],
      "cwd": null,
      "fullAccess": [
        "--dangerously-skip-permissions"
      ],
      "fullAccessWriteOnly": true
    },
    "env": {
      "ANTHROPIC_BASE_URL": "{baseUrl}",
      "ANTHROPIC_API_KEY": "{secret}",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "DISABLE_TELEMETRY": "1"
    },
    "envUnset": [
      "ANTHROPIC_AUTH_TOKEN",
      "CLAUDECODE",
      "CLAUDE_CODE_ENTRYPOINT"
    ],
    "caps": {
      "web": false,
      "exec": false,
      "vision": false
    },
    "knownModelCaps": {
      "qwen3.8-max": { "vision": true },
      "kimi-k3.1-pro": { "vision": true },
      "doubao-seed-2-0-pro-260215": { "vision": true },
      "deepseek-v4.1-flash-1017": { "vision": true }
    },
    "modelList": {
      "format": "openai-http"
    },
    "note": "按量计费。只读固定为计划模式；可写在最高权限打开时跳过逐项确认。密钥单独存放，不会写进配置。"
  }
}
